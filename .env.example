# ============================================================================
# Noor Bridal — environment template. Copy to .env and fill in.
# Dev preview needs only DATABASE_URL (SQLite). Everything else is production.
# ============================================================================

# --- Database (PostgreSQL) ---------------------------------------------------
# Neon / Supabase / Railway / RDS / local Postgres:
DATABASE_URL="postgresql://user:password@host:5432/noor_bridal?sslmode=require"

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://yourdomain.com"   # used in emails, sitemap, stripe redirects

# --- Transactional email (optional — falls back to in-app dev outbox) --------
# RESEND_API_KEY="re_xxxxxxxxxxxx"
# EMAIL_FROM="Noor Bridal <care@yourdomain.com>"

# --- Payments -----------------------------------------------------------------
# Stripe (US/CA). Without keys the platform runs the sandbox MOCK gateway.
# STRIPE_SECRET_KEY="sk_live_or_test_key"
# STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"   # webhook: {APP_URL}/api/payments/webhook

# --- Object storage (production media) ---------------------------------------
# Configure your S3-compatible bucket and swap the storage call in
# src/app/api/admin/upload/route.ts (contract stays the same: returns url).
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="auto"
